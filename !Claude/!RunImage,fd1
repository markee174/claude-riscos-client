REM ---------------------------------------------------------------
REM Event handling
REM ---------------------------------------------------------------

REM Poll the Wimp once. While a request runs, ask for null events
REM every half second so PROCcheckreply can look for the reply.
DEF PROCpoll
LOCAL r%,t%
IF busy% OR checking% OR selecting% THEN
  SYS "OS_ReadMonotonicTime" TO t%
  IF selecting% THEN t%+=4 ELSE t%+=50
  SYS "Wimp_PollIdle",&1830,blk%,t% TO r%
ELSE
  SYS "Wimp_Poll",&1831,blk% TO r%
ENDIF
CASE r% OF
  WHEN 0 : PROCcheckreply : PROCcheckupdate : IF selecting% THEN PROCseltrack
  WHEN 1 : IF blk%!0=mainw% THEN PROCredraw
  WHEN 2 : IF blk%!0=mainw% THEN PROCopenmain ELSE SYS "Wimp_OpenWindow",,blk%
  WHEN 3 : PROCclosereq
  WHEN 6 : PROCclick
  WHEN 7 : IF selecting% THEN PROCseltrack : selecting%=FALSE ELSE PROCdragend
  WHEN 8 : PROCkey
  WHEN 9 : PROCmenusel
  WHEN 17,18 : PROCmessage
ENDCASE
ENDPROC

REM Open the conversation window from the open block in blk%, keep
REM the toolbar pane on top of it, and rewrap if the width changed.
DEF PROCopenmain
LOCAL b%,w%
SYS "Wimp_OpenWindow",,blk%
SYS "Wimp_GetWindowState",,blk%
b%=blk%!28
IF b%=panew% THEN blk2%!0=panew% : SYS "Wimp_GetWindowState",,blk2% : b%=blk2%!28
blk2%!0=panew%
blk2%!4=blk%!4 : blk2%!8=blk%!16-toolh% : blk2%!12=blk%!12 : blk2%!16=blk%!16
blk2%!20=0 : blk2%!24=0 : blk2%!28=b%
SYS "Wimp_OpenWindow",,blk2%
blk%!28=panew%
SYS "Wimp_OpenWindow",,blk%
w%=blk%!12-blk%!4
IF w%<>lastw% THEN lastw%=w% : PROCresizepane(w%) : PROCrewrap
ENDPROC

REM Stretch the message field and move Send to suit width w%.
DEF PROCresizepane(w%)
SYS "Wimp_ResizeIcon",panew%,0,16,-74,w%-344,-22
SYS "Wimp_ResizeIcon",panew%,1,w%-160,-84,w%-16,-12
SYS "Wimp_ResizeIcon",panew%,2,w%-336,-78,w%-176,-22
SYS "Wimp_ForceRedraw",panew%,0,-toolh%,2000,0
ENDPROC

REM Close a window; the conversation window takes its pane with it.
DEF PROCclosereq
IF blk%!0=mainw% THEN blk2%!0=panew% : SYS "Wimp_CloseWindow",,blk2%
SYS "Wimp_CloseWindow",,blk%
ENDPROC

REM Open the conversation window at the front with the caret in it.
DEF PROCshowmain
blk%!0=mainw% : SYS "Wimp_GetWindowState",,blk%
blk%!28=-1
PROCopenmain
SYS "Wimp_SetCaretPosition",panew%,0,0,0,-1,FNclen(inbuf%)
ENDPROC

REM Handle a mouse click (buttons: 4 SELECT, 2 MENU, 1 ADJUST).
DEF PROCclick
LOCAL x%,y%,b%,w%,i%
x%=blk%!0 : y%=blk%!4 : b%=blk%!8 : w%=blk%!12 : i%=blk%!16
CASE TRUE OF
  WHEN b%=2 AND w%=-2 : PROCshowmenu(ibmenu%,x%-64,96+44*3)
  WHEN b%=2 AND (w%=mainw% OR w%=panew%) : PROCshowmenu(winmenu%,x%-64,y%)
  WHEN w%=-2 : PROCshowmain
  WHEN w%=mainw% : PROCmainclick(x%,y%,b%)
  WHEN w%=panew% AND i%=1 : PROCsend
  WHEN w%=choicesw% AND i%=7 : PROCsetchoices(b%)
  WHEN w%=choicesw% AND i%=6 : PROCcancelchoices(b%)
  WHEN w%=choicesw% AND i%=9 : PROCeditinstructions
  WHEN w%=choicesw% AND i%=10 : PROCtoggle(choicesw%,10)
  WHEN w%=updw% AND i%=2 : PROCtoggle(updw%,2)
  WHEN w%=updw% AND i%=3 : PROCupdatelater
  WHEN w%=updw% AND i%=4 : PROCupdatedownload
  WHEN w%=choicesw% AND i%=11 : PROCtoggle(choicesw%,11)
  WHEN w%=usew% AND i%=12 : PROCusagecancel(b%)
  WHEN w%=usew% AND i%=13 : PROCusageset(b%)
  WHEN w%=panew% AND i%=2 : PROCopenatt
  WHEN w%=attw% AND i%=3 : PROCaddpath
  WHEN w%=savew% AND i%=0 AND (b% AND &50)<>0 : PROCstartdrag
  WHEN w%=savew% AND i%=2 : SYS "Wimp_CreateMenu",,-1
  WHEN w%=savew% AND i%=3 : PROCsavebutton
  WHEN w%=attw% AND i%=5 : PROCremoveatt
  WHEN w%=attw% AND i%=6 : IF b%<>1 THEN blk2%!0=attw% : SYS "Wimp_CloseWindow",,blk2%
ENDCASE
ENDPROC

REM Return sends a message or confirms Choices; Escape cancels Choices.
DEF PROCkey
LOCAL w%,k%
w%=blk%!0 : k%=blk%!24
CASE TRUE OF
  WHEN w%=panew% AND k%=13 : PROCsend
  WHEN k%=3 AND sels%<>sele% : PROCcopy
  WHEN w%=choicesw% AND k%=13 : PROCsetchoices(4)
  WHEN w%=choicesw% AND k%=27 : PROCcancelchoices(4)
  WHEN w%=attw% AND k%=13 : PROCaddpath
  WHEN w%=savew% AND k%=13 : PROCsavebutton
  WHEN w%=savew% AND k%=27 : SYS "Wimp_CreateMenu",,-1
  WHEN w%=updw% AND k%=13 : PROCupdatedownload
  WHEN w%=updw% AND k%=27 : PROCupdatelater
  WHEN w%=usew% AND k%=13 : PROCusageset(4)
  WHEN w%=usew% AND k%=27 : PROCusagecancel(4)
  WHEN w%=attw% AND k%=27 : blk2%!0=attw% : SYS "Wimp_CloseWindow",,blk2%
  OTHERWISE SYS "Wimp_ProcessKey",k%
ENDCASE
ENDPROC

REM Open menu m% and remember it for menu selections.
DEF PROCshowmenu(m%,x%,y%)
curmenu%=m% : menux%=x% : menuy%=y%
IF m%=winmenu% THEN PROCshadesave
SYS "Wimp_CreateMenu",,m%,x%,y%
ENDPROC

REM Act on a menu choice; ADJUST keeps the menu open.
DEF PROCmenusel
LOCAL s%
s%=blk%!0
SYS "Wimp_GetPointerInfo",,ptr%
CASE curmenu% OF
  WHEN ibmenu% :
    CASE s% OF
      WHEN 1 : PROCopenchoices
      WHEN 2 : quit%=TRUE
    ENDCASE
  WHEN winmenu% :
    CASE s% OF
      WHEN 4 : PROCcopy
      WHEN 5 : PROCsetsel(0,displen%)
      WHEN 6 : PROCopenusage
      WHEN 7 : PROCclear
      WHEN 8 : PROCopenchoices
    ENDCASE
ENDCASE
IF (ptr%!8 AND 1) AND NOT quit% THEN SYS "Wimp_CreateMenu",,curmenu%,menux%,menuy%
ENDPROC

REM Handle Message_Quit and Message_HelpRequest.
DEF PROCmessage
CASE blk%!16 OF
  WHEN 0 : quit%=TRUE
  WHEN 1 : PROCdatasave
  WHEN 2 : PROCdatasaveack
  WHEN 3 : PROCdataload
  WHEN &F : IF blk%!4<>task% AND (blk%!20 AND 4)<>0 THEN haveclip%=FALSE
  WHEN &10 : PROCdatarequest
  WHEN &400C0 : PROCmenuwarn
  WHEN &502 : PROChelp
ENDCASE
ENDPROC

REM Answer an interactive help request for window blk%!32, icon blk%!36.
DEF PROChelp
LOCAL t$
t$=FNhelp(blk%!32,blk%!36)
IF t$="" THEN ENDPROC
blk%!12=blk%!8 : blk%!16=&503
$(blk%+20)=t$ : blk%?(20+LEN t$)=0
blk%!0=(24+LEN t$) AND NOT 3
SYS "Wimp_SendMessage",17,blk%,blk%!4
ENDPROC

REM Return help text for icon i% in window w%, or "".
DEF FNhelp(w%,i%)
LOCAL h$
h$=""
CASE w% OF
  WHEN -2 : h$="This is the Claude icon.|MClick SELECT to open the conversation window.|MClick MENU for Info, Choices and Quit."
  WHEN mainw% : h$="Your conversation with Claude.|MDrag with SELECT to select text; ADJUST extends it.|MDrop files here to attach them.|MClick MENU to copy, save or clear."
  WHEN savew% :
    CASE i% OF
      WHEN 0 : h$="Drag this icon to a directory display to save the file."
      WHEN 1 : h$="Enter a name for the file, or a full pathname and click Save."
      WHEN 2 : h$="Click SELECT to close this box without saving."
      WHEN 3 : h$="Click SELECT to save to the full pathname above."
    ENDCASE
  WHEN panew% :
    CASE i% OF
      WHEN 1 : h$="Click SELECT to send your message to Claude, with any attached files."
      WHEN 2 : h$="Click SELECT to open the Attachments window.|MYou can also drag files onto the conversation window."
      OTHERWISE h$="Type a message to Claude, then press Return to send it."
    ENDCASE
  WHEN choicesw% :
    CASE i% OF
      WHEN 1 : h$="Enter your Anthropic API key, from console.anthropic.com."
      WHEN 3 : h$="Enter a model name, for example claude-sonnet-5-5."
      WHEN 5 : h$="Optional: the full pathname of a CA certificate file for curl. Leave it empty unless curl reports a certificate error."
      WHEN 6 : h$="Click SELECT to close this window without saving.|MClick ADJUST to restore the saved values."
