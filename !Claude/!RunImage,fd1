REM ---------------------------------------------------------------
REM Sending a message
REM ---------------------------------------------------------------

REM Add the typed message to the conversation and start curl.
DEF PROCsend
LOCAL n%,i%,c%
IF busy% THEN ENDPROC
n%=FNclen(inbuf%)
IF n%=0 AND FNpending=0 THEN ENDPROC
IF key$="" THEN PROCreport("Set your Anthropic API key in Choices first.") : PROCopenchoices : ENDPROC
IF histlen%+FNmsgsize(n%)>=bufsize% THEN PROCwarn("This message and its attachments are too long for the conversation. Choose Clear from the menu, or attach less.") : ENDPROC
prevhist%=histlen%
PROCdispbyte(1)
i%=0
WHILE i%<n%
  c%=inbuf%?i%
  IF c%>=32 THEN PROCdispbyte(c%)
  i%+=1
ENDWHILE
PROChistbegin(1) : PROChistesc(inbuf%,n%) : PROCattachtext : PROChistend
PROCdelscratch
SYS "Hourglass_On"
PROCwritereq : PROCwritecfg : PROCwriteobey
SYS "Hourglass_Off"
SYS "Wimp_StartTask","TaskWindow ""Obey "+obey$+""" -name ""Claude request"" -wimpslot 8192K -quit"
?inbuf%=0 : PROCredrawicon(panew%,0)
SYS "Wimp_SetCaretPosition",panew%,0,0,0,-1,0
SYS "OS_ReadMonotonicTime" TO started%
busy%=TRUE : PROCbusyui
PROCrefresh
ENDPROC

REM Write the JSON request body: model, token limit, whole history.
DEF PROCwritereq
LOCAL f%,p%,n%
f%=OPENOUT req$
PROCput(f%,"{""model"":"""+model$+""",""max_tokens"":4096,")
n%=FNloadinstructions
IF n%>0 THEN PROCput(f%,"""system"":""") : PROCputesc(f%,resp%,n%) : PROCput(f%,""",")
PROCput(f%,"""messages"":[")
p%=0
WHILE p%<histlen%
  IF p%>0 THEN PROCput(f%,",")
  n%=hist%!(p%+4)
  IF p%=prevhist% AND FNbincount>0 THEN
    PROCput(f%,"{""role"":""user"",""content"":[")
    PROCputbinaries(f%)
    PROCput(f%,"{""type"":""text"",""text"":""")
    IF n%>0 THEN SYS "OS_GBPB",2,f%,hist%+p%+8,n%
    PROCput(f%,"""}]}")
  ELSE
    IF hist%?p%=1 THEN PROCput(f%,"{""role"":""user"",""content"":""") ELSE PROCput(f%,"{""role"":""assistant"",""content"":""")
    IF n%>0 THEN SYS "OS_GBPB",2,f%,hist%+p%+8,n%
    PROCput(f%,"""}")
  ENDIF
  p%=(p%+8+n%+3) AND NOT 3
ENDWHILE
PROCput(f%,"]}")
CLOSE#f%
ENDPROC

REM Load CLAUDE.md into resp% and return its length, or 0 if there is
REM none. resp% is free at this point: the last reply is already parsed.
DEF FNloadinstructions
LOCAL n%
n%=FNlen("Choices:Claude.CLAUDE/md")
IF n%<=0 OR n%>=bufsize% THEN n%=0 ELSE SYS "OS_File",255,"Choices:Claude.CLAUDE/md",resp%,0
=n%

REM Write n% Latin-1 bytes from a% to file f% as JSON string content.
DEF PROCputesc(f%,a%,n%)
LOCAL i%,c%
i%=0
WHILE i%<n%
  c%=a%?i%
  CASE TRUE OF
    WHEN c%=34 OR c%=92 : BPUT#f%,92 : BPUT#f%,c%
    WHEN c%<32 OR c%>=128 : PROCput(f%,"\u"+RIGHT$("000"+STR$~c%,4))
    OTHERWISE BPUT#f%,c%
  ENDCASE
  i%+=1
ENDWHILE
ENDPROC

REM Open CLAUDE.md in the user's text editor, creating it first with
REM starter instructions if it does not exist in <Choices$Write>.
DEF PROCeditinstructions
LOCAL f$,f%
SYS "OS_File",8,"<Choices$Write>.Claude",,,0
f$=FNcanon("<Choices$Write>.Claude")+".CLAUDE/md"
IF FNlen(f$)<0 THEN
  f%=OPENOUT f$
  PROCline(f%,"You are chatting through !Claude, a desktop client on RISC OS.")
  PROCline(f%,"Replies appear as plain text in the desktop font, which shows Latin-1 characters only.")
  PROCline(f%,"Avoid Markdown formatting, tables and emoji.")
  PROCline(f%,"Put code in ``` fenced blocks with the language named, for example ```basic, so it can be saved.")
  CLOSE#f%
  SYS "OS_File",18,f$,&FFF
ENDIF
OSCLI "Filer_Run "+f$
ENDPROC

REM Write the curl config file. The API key lives here rather than on
REM the command line; PROCdelscratch removes it after each request.
DEF PROCwritecfg
LOCAL f%
f%=OPENOUT cfg$
PROCline(f%,"url = ""https://api.anthropic.com/v1/messages""")
PROCline(f%,"header = ""x-api-key: "+key$+"""")
PROCline(f%,"header = ""anthropic-version: 2023-06-01""")
PROCline(f%,"header = ""content-type: application/json""")
PROCline(f%,"data-binary = ""@"+req$+"""")
PROCline(f%,"output = """+out$+"""")
PROCline(f%,"stderr = """+err$+"""")
PROCline(f%,"silent")
PROCline(f%,"show-error")
PROCline(f%,"max-time = 170")
IF cert$<>"" THEN PROCline(f%,"cacert = """+cert$+"""")
CLOSE#f%
ENDPROC

REM Write the Obey file the TaskWindow runs: curl, then a marker file.
DEF PROCwriteobey
LOCAL f%
f%=OPENOUT obey$
PROCline(f%,"curl -K "+cfg$)
PROCline(f%,"Create "+done$)
CLOSE#f%
ENDPROC

REM Shade Send and retitle the window while a request runs.
DEF PROCbusyui
PROCsettitle
blk2%!0=panew% : blk2%!4=1 : blk2%!12=1<<22
IF busy% THEN blk2%!8=1<<22 ELSE blk2%!8=0
SYS "Wimp_SetIconState",,blk2%
SYS "Wimp_ForceRedraw",mainw%,&4B534154,3
ENDPROC

REM ---------------------------------------------------------------
REM Attachments
REM Kinds: 1 text (inlined into the message), 2 image, 3 PDF (sent as
REM base64 blocks with the next message only; history keeps a note).
REM ---------------------------------------------------------------

REM Load file f$ into attbuf% as attachment called n$, if it is a kind
REM Claude can read. Warn and drop it otherwise.
DEF PROCattach(f$,n$)
LOCAL t%,len%,k%,a%,ft%
IF busy% THEN PROCwarn("Wait for Claude's reply before attaching more files.") : ENDPROC
SYS "XOS_File",23,f$ TO t%,,,,len%,,ft%
IF t%<>1 THEN PROCwarn("Only files can be attached, not directories or applications: "+n$) : ENDPROC
IF len%=0 THEN PROCwarn(n$+" is empty.") : ENDPROC
IF natt%-firstpend%>=maxatt% THEN PROCwarn("You can attach up to "+STR$maxatt%+" files to one message.") : ENDPROC
IF natt%>=keepmax% OR attused%+len%>attmax% THEN PROCdropsent
IF attused%+len%>attmax% THEN PROCwarn(n$+" is too large. Attachments to one message can total "+STR$(attmax% DIV 1048576)+"MB.") : ENDPROC
a%=attbuf%+attused%
SYS "Hourglass_On"
SYS "OS_File",255,f$,a%,0
k%=FNkind(a%,len%)
SYS "Hourglass_Off"
IF k%=0 THEN PROCwarn("Claude cannot read "+n$+". Attach text, JPEG, PNG, GIF, WebP or PDF files. Convert other images, such as Sprites, to JPEG or PNG first.") : ENDPROC
attname$(natt%)=n$ : attkind%(natt%)=k% : attmedia$(natt%)=kmedia$ : attftype%(natt%)=ft%
attoff%(natt%)=attused% : attlen%(natt%)=len%
attused%=(attused%+len%+3) AND NOT 3
natt%+=1
PROCsetattlist
PROCnote("Attached "+n$+" ("+FNkindname(k%,kmedia$)+", "+FNsize(len%)+"). It will be sent with your next message.")
ENDPROC

REM Return the kind of the n% bytes at a% (0 if unsupported), setting
REM kmedia$ to the media type for images and PDFs.
DEF FNkind(a%,n%)
LOCAL k%,i%,c%
k%=0 : kmedia$=""
IF n%>=4 THEN
  CASE TRUE OF
    WHEN a%?0=&FF AND a%?1=&D8 AND a%?2=&FF : k%=2 : kmedia$="image/jpeg"
    WHEN a%?0=&89 AND a%?1=&50 AND a%?2=&4E AND a%?3=&47 : k%=2 : kmedia$="image/png"
    WHEN a%?0=&47 AND a%?1=&49 AND a%?2=&46 AND a%?3=&38 : k%=2 : kmedia$="image/gif"
    WHEN a%?0=&25 AND a%?1=&50 AND a%?2=&44 AND a%?3=&46 : k%=3 : kmedia$="application/pdf"
  ENDCASE
ENDIF
IF k%=0 AND n%>=12 THEN
  IF a%?0=&52 AND a%?1=&49 AND a%?2=&46 AND a%?3=&46 AND a%?8=&57 AND a%?9=&45 AND a%?10=&42 AND a%?11=&50 THEN k%=2 : kmedia$="image/webp"
ENDIF
IF k%=0 THEN
  k%=1 : i%=0
  WHILE k%=1 AND i%<n%
    c%=a%?i%
    IF c%<32 AND c%<>9 AND c%<>10 AND c%<>13 THEN k%=0
    i%+=1
  ENDWHILE
ENDIF
=k%

REM History bytes needed for the typed message (n% bytes) plus any
REM text attachments once JSON-escaped, with room for notes.
DEF FNmsgsize(n%)
LOCAL i%,t%
t%=FNesclen(inbuf%,n%)+1024 : i%=firstpend%
WHILE i%<natt%
  IF attkind%(i%)=1 THEN t%+=FNesclen(attbuf%+attoff%(i%),attlen%(i%))
  i%+=1
ENDWHILE
=t%

REM Length of n% bytes at a% after PROChistesc escaping.
DEF FNesclen(a%,n%)
LOCAL i%,c%,t%
t%=0 : i%=0
WHILE i%<n%
  c%=a%?i%
  IF c%=34 OR c%=92 THEN t%+=2 ELSE IF c%<32 OR c%>=128 THEN t%+=6 ELSE t%+=1
  i%+=1
ENDWHILE
=t%

REM Number of image and PDF attachments waiting to be sent.
DEF FNbincount
LOCAL i%,c%
c%=0 : i%=firstpend%
WHILE i%<natt%
  IF attkind%(i%)>1 THEN c%+=1
  i%+=1
ENDWHILE
=c%

REM Add each attachment to the history record being built and to the
REM display: text files in full, images and PDFs as a note.
DEF PROCattachtext
LOCAL i%
i%=firstpend%
WHILE i%<natt%
  PROCdispbyte(10) : PROCdispstr("[Attached: "+attname$(i%)+"]")
  CASE attkind%(i%) OF
    WHEN 1 :
      PROChiststr(CHR$10+CHR$10+"File: "+attname$(i%)+CHR$10)
      PROChistesc(attbuf%+attoff%(i%),attlen%(i%))
    WHEN 2 : PROChiststr(CHR$10+"[Attached image: "+attname$(i%)+"]")
    WHEN 3 : PROChiststr(CHR$10+"[Attached PDF: "+attname$(i%)+"]")
  ENDCASE
  i%+=1
ENDWHILE
ENDPROC

REM JSON-escape s$ into the history record being built.
DEF PROChiststr(s$)
IF s$="" THEN ENDPROC
$tmpbuf%=s$
PROChistesc(tmpbuf%,LEN s$)
ENDPROC

REM Write an image or document content block for each binary attachment.
DEF PROCputbinaries(f%)
LOCAL i%
i%=firstpend%
WHILE i%<natt%
  IF attkind%(i%)=2 THEN PROCput(f%,"{""type"":""image"",""source"":{""type"":""base64"",""media_type"":"""+attmedia$(i%)+""",""data"":""")
  IF attkind%(i%)=3 THEN PROCput(f%,"{""type"":""document"",""source"":{""type"":""base64"",""media_type"":"""+attmedia$(i%)+""",""data"":""")
  IF attkind%(i%)>1 THEN PROCputb64(f%,attbuf%+attoff%(i%),attlen%(i%)) : PROCput(f%,"""}},")
  i%+=1
ENDWHILE
ENDPROC

REM Write n% bytes from a% to file f% as base64, 64K at a time.
DEF PROCputb64(f%,a%,n%)
LOCAL i%,o%,v%
i%=0 : o%=0
WHILE i%<n%
  v%=(a%?i%)<<16
  IF i%+1<n% THEN v%+=(a%?(i%+1))<<8
  IF i%+2<n% THEN v%+=a%?(i%+2)
  b64buf%?o%=b64tab%?((v%>>>18) AND 63)
  b64buf%?(o%+1)=b64tab%?((v%>>>12) AND 63)
  IF i%+1<n% THEN b64buf%?(o%+2)=b64tab%?((v%>>>6) AND 63) ELSE b64buf%?(o%+2)=61
  IF i%+2<n% THEN b64buf%?(o%+3)=b64tab%?(v% AND 63) ELSE b64buf%?(o%+3)=61
  o%+=4 : i%+=3
  IF o%>=65532 THEN SYS "OS_GBPB",2,f%,b64buf%,o% : o%=0
ENDWHILE
IF o%>0 THEN SYS "OS_GBPB",2,f%,b64buf%,o%
ENDPROC

REM Claude has replied: the waiting attachments become sent ones, kept
REM so they can still be saved from the window menu.
DEF PROCclearatt
firstpend%=natt%
PROCsetattlist
ENDPROC

REM Remove the waiting attachments at the user's request, and say so.
DEF PROCremoveatt
IF natt%=firstpend% THEN ENDPROC
attused%=attoff%(firstpend%) : natt%=firstpend%
PROCsetattlist
PROCnote("Removed all attached files.")
ENDPROC

REM Forget sent attachments to make room, moving any waiting ones down.
DEF PROCdropsent
LOCAL i%,j%,o%
IF firstpend%=0 THEN ENDPROC
IF natt%>firstpend% THEN
  o%=attoff%(firstpend%)
  SYS "Hourglass_On"
  FOR i%=0 TO attused%-o%-4 STEP 4
    attbuf%!i%=attbuf%!(o%+i%)
  NEXT
  SYS "Hourglass_Off"
ELSE
  o%=attused%
ENDIF
j%=0 : i%=firstpend%
WHILE i%<natt%
  attname$(j%)=attname$(i%) : attkind%(j%)=attkind%(i%) : attmedia$(j%)=attmedia$(i%)
  attoff%(j%)=attoff%(i%)-o% : attlen%(j%)=attlen%(i%) : attftype%(j%)=attftype%(i%)
  i%+=1 : j%+=1
ENDWHILE
attused%-=o% : natt%=j% : firstpend%=0
ENDPROC

REM Number of attachments waiting to be sent.
DEF FNpending
=natt%-firstpend%

REM Add a grey note paragraph to the conversation and show it.
DEF PROCnote(m$)
PROCdispbyte(4) : PROCdispstr(m$)
PROCrefresh
ENDPROC

REM Describe attachment kind k% with media type m$.
DEF FNkindname(k%,m$)
LOCAL d$
d$="text file"
IF k%=3 THEN d$="PDF"
IF k%=2 THEN d$=FNupper(MID$(m$,7))+" image"
=d$

REM s$ in upper case.
DEF FNupper(s$)
LOCAL i%,c%,u$
u$=""
FOR i%=1 TO LEN s$
  c%=ASC MID$(s$,i%,1)
  IF c%>=97 AND c%<=122 THEN c%-=32
  u$+=CHR$c%
NEXT
=u$

REM n% bytes as a short size: bytes, KB or MB.
DEF FNsize(n%)
LOCAL s$
s$=STR$n%+" bytes"
IF n%>=1024 THEN s$=STR$((n%+512) DIV 1024)+"KB"
IF n%>=1048576 THEN s$=STR$(n% DIV 1048576)+"."+STR$((n% MOD 1048576)*10 DIV 1048576)+"MB"
=s$

REM Update the Attachments window list and the conversation window title.
DEF PROCsetattlist
LOCAL s$,i%
IF FNpending=0 THEN s$="No files attached." ELSE s$=STR$FNpending+" attached: "
i%=firstpend%
WHILE i%<natt%
  IF i%>firstpend% THEN s$+=", "
  IF LEN s$+LEN attname$(i%)<240 THEN s$+=attname$(i%) ELSE s$+="..." : i%=natt%
  i%+=1
ENDWHILE
$attlist%=s$
PROCredrawicon(attw%,0)
PROCsettitle
ENDPROC

REM Title: waiting while busy, else the number of files attached.
DEF PROCsettitle
CASE TRUE OF
  WHEN busy% : $titlebuf%=app$+" (waiting for a reply)"
  WHEN FNpending=1 : $titlebuf%=app$+" (1 file attached)"
  WHEN FNpending>1 : $titlebuf%=app$+" ("+STR$FNpending+" files attached)"
  OTHERWISE $titlebuf%=app$
ENDCASE
SYS "Wimp_ForceRedraw",mainw%,&4B534154,3
ENDPROC

REM Open the Attachments window at the front, caret in the pathname field.
DEF PROCopenatt
blk%!0=attw% : SYS "Wimp_GetWindowState",,blk%
blk%!28=-1 : SYS "Wimp_OpenWindow",,blk%
SYS "Wimp_SetCaretPosition",attw%,2,0,0,-1,FNclen(pathbuf%)
ENDPROC

REM Attach the file typed in the pathname field.
DEF PROCaddpath
LOCAL f$
f$=FNtrim(FNcstr(pathbuf%))
IF f$="" THEN ENDPROC
PROCattach(f$,FNleaf(f$))
?pathbuf%=0 : PROCredrawicon(attw%,2)
SYS "Wimp_SetCaretPosition",attw%,2,0,0,-1,0
ENDPROC

REM Leaf name of pathname p$.
DEF FNleaf(p$)
LOCAL i%
i%=LEN p$
WHILE i%>0 AND MID$(p$,i%,1)<>"." AND MID$(p$,i%,1)<>":"
  i%-=1
ENDWHILE
=MID$(p$,i%+1)

REM TRUE if window w% accepts dropped files.
DEF FNdroptarget(w%)
=(w%=mainw% OR w%=panew% OR w%=attw% OR w%=-2)

REM Another application wants to save data to us: ask for it in
REM <Wimp$Scrap> and remember the leaf name it offered.
DEF PROCdatasave
IF blk%!4=task% THEN ENDPROC
IF NOT FNdroptarget(blk%!20) THEN ENDPROC
saveleaf$=FNcstr(blk%+44)
blk%!12=blk%!8 : blk%!16=2 : blk%!36=-1
$(blk%+44)="<Wimp$Scrap>" : blk%?(44+12)=0
blk%!0=60
SYS "Wimp_SendMessage",17,blk%,blk%!4
saveref%=blk%!8
ENDPROC

REM A file was dropped on one of our windows, or saved via <Wimp$Scrap>.
DEF PROCdataload
LOCAL f$,n$,t%,scrap%,w%
w%=blk%!20
IF NOT FNdroptarget(w%) THEN ENDPROC
f$=FNcstr(blk%+44) : t%=blk%!40
scrap%=(saveref%<>0 AND blk%!12=saveref%)
IF scrap% THEN n$=saveleaf$ ELSE n$=FNleaf(f$)
saveref%=0
blk%!12=blk%!8 : blk%!16=4
SYS "Wimp_SendMessage",17,blk%,blk%!4
IF t%=&1000 OR t%=&2000 THEN PROCwarn("Only files can be attached, not directories or applications: "+n$) ELSE PROCattach(f$,n$)
IF scrap% THEN SYS "XOS_File",6,"<Wimp$Scrap>"
IF w%=-2 THEN PROCshowmain
ENDPROC

REM ---------------------------------------------------------------
REM Saving
REM The window menu offers Save conversation, Save reply and Save code,
REM each opening the Save as box. Files are saved by dragging its icon
REM to a Filer window (Message_DataSave protocol) or by typing a full
REM pathname and clicking Save.
REM ---------------------------------------------------------------

REM Shade Save menu items that would save nothing.
DEF PROCshadesave
LOCAL i%
FOR i%=0 TO 2
  PROCshade(winmenu%,i%,FNbuildsave(i%+1)=0)
NEXT
PROCbuildattmenu
PROCshade(winmenu%,3,natt%=0)
PROCshade(winmenu%,4,sels%=sele%)
PROCshade(winmenu%,5,displen%=0)
ENDPROC

REM Shade item i% of menu m% if on% is TRUE, else unshade it.
DEF PROCshade(m%,i%,on%)
LOCAL a%
a%=m%+28+24*i%+8
IF on% THEN !a%=!a% OR (1<<22) ELSE !a%=!a% AND NOT (1<<22)
ENDPROC

REM Fill the Save attachment submenu with one item per kept attachment.
DEF PROCbuildattmenu
LOCAL i%,a%,w%
w%=LEN "Attachments"*16+16
IF natt%=0 THEN ENDPROC
FOR i%=0 TO natt%-1
  a%=attmenu%+28+24*i%
  $(attmtext%+64*i%)=LEFT$(attname$(i%),60)
  IF i%=natt%-1 THEN a%!0=&88 ELSE a%!0=&08
  a%!4=savew% : a%!8=&07000121 : a%!12=attmtext%+64*i% : a%!16=-1 : a%!20=64
  IF LEN attname$(i%)*16+16>w% THEN w%=LEN attname$(i%)*16+16
NEXT
attmenu%!16=w%
ENDPROC

REM A Save item's submenu is about to open: fill the Save as box for it.
DEF PROCmenuwarn
LOCAL s$
IF curmenu%<>winmenu% OR blk%!20<>savew% THEN ENDPROC
IF blk%!32=3 THEN
  PROCattsave(blk%!36)
ELSE
  savelen%=FNbuildsave(blk%!32+1)
ENDIF
$savenamebuf%=savename$ : PROCredrawicon(savew%,1)
s$=FNlower("file_"+RIGHT$("00"+STR$~savetype%,3))
IF NOT FNspriteexists(s$) THEN s$="file_xxx"
$sprname%=s$ : PROCredrawicon(savew%,0)
SYS "Wimp_CreateSubMenu",,savew%,blk%!24,blk%!28
ENDPROC

REM TRUE if the Wimp sprite pool has sprite s$.
DEF FNspriteexists(s$)
LOCAL f%
SYS "XWimp_SpriteOp",40,,s$ TO ;f%
=((f% AND 1)=0)

REM Build what kind k% saves into sav% and return its length:
REM 1 whole conversation, 2 last reply, 3 code blocks in the last reply.
REM Sets savename$ and savetype% to suit.
DEF FNbuildsave(k%)
LOCAL o%,p%,c%,rs%,re%
o%=0 : savetype%=&FFF : savesrc%=sav%
rs%=-1 : p%=0
WHILE p%<displen%
  IF disp%?p%=2 THEN rs%=p%+1
  p%+=1
ENDWHILE
re%=displen%
IF rs%>=0 THEN
  p%=rs%
  WHILE p%<displen% AND disp%?p%>4
    p%+=1
  ENDWHILE
  re%=p%
ENDIF
CASE k% OF
  WHEN 1 :
    savename$="Conversation" : p%=0
    WHILE p%<displen%
      c%=disp%?p%
      IF c%<5 THEN
        IF o%>0 THEN o%=FNsavestr(o%,CHR$10+CHR$10)
        CASE c% OF
          WHEN 1 : o%=FNsavestr(o%,"You:"+CHR$10)
          WHEN 2 : o%=FNsavestr(o%,"Claude:"+CHR$10)
          WHEN 3 : o%=FNsavestr(o%,"Error:"+CHR$10)
        ENDCASE
      ELSE
        IF o%<bufsize%-1 THEN sav%?o%=c% : o%+=1
      ENDIF
      p%+=1
    ENDWHILE
  WHEN 2 :
    savename$="Reply"
    IF rs%>=0 THEN
      p%=rs%
      WHILE p%<re%
        sav%?o%=disp%?p% : o%+=1 : p%+=1
      ENDWHILE
    ENDIF
  WHEN 3 :
    savename$="Code"
    IF rs%>=0 THEN o%=FNbuildcode(rs%,re%)
ENDCASE
=o%

REM Copy the lines inside ``` fences between disp% offsets s% and e%
REM into sav%. The first fence's language sets the file type.
DEF FNbuildcode(s%,e%)
LOCAL o%,p%,l%,inf%,first%,lang$
o%=0 : p%=s% : inf%=FALSE : first%=TRUE
WHILE p%<e%
  l%=p%
  WHILE l%<e% AND disp%?l%<>10
    l%+=1
  ENDWHILE
  IF l%-p%>=3 AND disp%?p%=96 AND disp%?(p%+1)=96 AND disp%?(p%+2)=96 THEN
    IF NOT inf% THEN
      IF first% THEN lang$=FNlower(FNtrim(FNdispstr(p%+3,l%))) : first%=FALSE
      IF o%>0 THEN sav%?o%=10 : o%+=1
    ENDIF
    inf%=NOT inf%
  ELSE
    IF inf% THEN
      WHILE p%<l%
        sav%?o%=disp%?p% : o%+=1 : p%+=1
      ENDWHILE
      sav%?o%=10 : o%+=1
    ENDIF
  ENDIF
  p%=l%+1
ENDWHILE
IF o%>0 THEN
  CASE lang$ OF
    WHEN "basic","bbcbasic","bbc basic","bbc" : savetype%=&FD1 : savename$="Program"
    WHEN "obey" : savetype%=&FEB : savename$="Obey"
  ENDCASE
ENDIF
=o%

REM Append s$ to sav% at offset o%; return the new offset.
DEF FNsavestr(o%,s$)
LOCAL i%
FOR i%=1 TO LEN s$
  IF o%<bufsize%-1 THEN sav%?o%=ASC MID$(s$,i%,1) : o%+=1
NEXT
=o%

REM Display buffer bytes s% to e% (at most 255) as a string.
DEF FNdispstr(s%,e%)
LOCAL l$
l$=""
WHILE s%<e% AND LEN l$<255
  l$+=CHR$(disp%?s%) : s%+=1
ENDWHILE
=l$

REM s$ in lower case.
DEF FNlower(s$)
LOCAL i%,c%,l$
l$=""
FOR i%=1 TO LEN s$
  c%=ASC MID$(s$,i%,1)
  IF c%>=65 AND c%<=90 THEN c%+=32
  l$+=CHR$c%
NEXT
=l$

REM Start dragging the Save as icon.
DEF PROCstartdrag
LOCAL ox%,oy%
ws%!0=savew% : SYS "Wimp_GetWindowState",,ws%
ox%=ws%!4-ws%!20 : oy%=ws%!16-ws%!24
blk2%!0=savew% : blk2%!4=0 : SYS "Wimp_GetIconState",,blk2%
drag%!0=savew% : drag%!4=5
drag%!8=ox%+blk2%!8 : drag%!12=oy%+blk2%!12 : drag%!16=ox%+blk2%!16 : drag%!20=oy%+blk2%!20
drag%!24=&80000000 : drag%!28=&80000000 : drag%!32=&7FFFFFFF : drag%!36=&7FFFFFFF
SYS "Wimp_DragBox",,drag%
dragging%=TRUE
ENDPROC

REM The drag ended: offer the file to whatever is under the pointer.
DEF PROCdragend
LOCAL l$
IF NOT dragging% THEN ENDPROC
dragging%=FALSE
SYS "Wimp_GetPointerInfo",,ptr%
IF ptr%!12=savew% THEN ENDPROC
l$=FNleaf(FNtrim(FNcstr(savenamebuf%)))
IF l$="" THEN l$=savename$
blk%!12=0 : blk%!16=1
blk%!20=ptr%!12 : blk%!24=ptr%!16 : blk%!28=ptr%!0 : blk%!32=ptr%!4
blk%!36=savelen% : blk%!40=savetype%
$(blk%+44)=l$ : blk%?(44+LEN l$)=0
blk%!0=(48+LEN l$) AND NOT 3
SYS "Wimp_SendMessage",18,blk%,ptr%!12,ptr%!16
saveout%=blk%!8 : saveclip%=FALSE
ENDPROC

REM The Filer replied with a pathname: save there and confirm.
DEF PROCdatasaveack
LOCAL f$
IF saveout%=0 OR blk%!12<>saveout% THEN ENDPROC
saveout%=0
f$=FNcstr(blk%+44)
IF saveclip% THEN
  SYS "OS_File",10,f$,&FFF,,clip%,clip%+cliplen%
ELSE
  PROCwritesave(f$)
  IF blk%!36<>-1 THEN $savenamebuf%=f$
ENDIF
blk%!12=blk%!8 : blk%!16=3
SYS "Wimp_SendMessage",18,blk%,blk%!4
IF NOT saveclip% THEN SYS "Wimp_CreateMenu",,-1
saveclip%=FALSE
ENDPROC

REM Save button or Return: save to a full pathname, if one was typed.
DEF PROCsavebutton
LOCAL f$
f$=FNtrim(FNcstr(savenamebuf%))
IF INSTR(f$,".")=0 AND INSTR(f$,":")=0 THEN PROCwarn("To save, drag the icon to a directory display.") : ENDPROC
PROCwritesave(f$)
SYS "Wimp_CreateMenu",,-1
ENDPROC

REM Write sav% to file f$ with type savetype%.
DEF PROCwritesave(f$)
SYS "OS_File",10,f$,savetype%,,savesrc%,savesrc%+savelen%
ENDPROC

REM Set up the Save as box for kept attachment j%, with its own type.
DEF PROCattsave(j%)
savesrc%=attbuf%+attoff%(j%) : savelen%=attlen%(j%)
savetype%=attftype%(j%) : savename$=attname$(j%)
ENDPROC

REM ---------------------------------------------------------------
REM Selecting and copying text
REM sels% is where a selection started and sele% where it ends; either
REM may be the larger. Both are offsets into the display buffer.
REM ---------------------------------------------------------------

REM Mouse click in the conversation window's work area. With button
REM type 10: drag 64/16, single click 1024/256, double click 4.
DEF PROCmainclick(x%,y%,b%)
LOCAL p%
p%=FNposat(x%,y%)
CASE b% OF
  WHEN 64 : PROCsetsel(p%,p%) : PROCstartseldrag
  WHEN 16 : PROCstartseldrag
  WHEN 1024 : PROCsetsel(p%,p%)
  WHEN 256 : PROCsetsel(sels%,p%)
  WHEN 4 : PROCselpara(p%)
ENDCASE
ENDPROC

REM Start an invisible drag that keeps the pointer in the window.
DEF PROCstartseldrag
ws%!0=mainw% : SYS "Wimp_GetWindowState",,ws%
drag%!0=mainw% : drag%!4=7
drag%!8=0 : drag%!12=0 : drag%!16=0 : drag%!20=0
drag%!24=ws%!4 : drag%!28=ws%!8 : drag%!32=ws%!12 : drag%!36=ws%!16-toolh%
SYS "Wimp_DragBox",,drag%
selecting%=TRUE
ENDPROC

REM While dragging: move the selection end to the pointer, scrolling
REM when the pointer reaches the top or bottom of the window.
DEF PROCseltrack
LOCAL p%
SYS "Wimp_GetPointerInfo",,ptr%
PROCautoscroll(ptr%!4)
p%=FNposat(ptr%!0,ptr%!4)
IF p%<>sele% THEN PROCsetsel(sels%,p%)
ENDPROC

REM Scroll one line if y% is near the top or bottom of the window.
DEF PROCautoscroll(y%)
LOCAL i%,d%
ws%!0=mainw% : SYS "Wimp_GetWindowState",,ws%
d%=0
IF y%<ws%!8+lh% THEN d%=-lh%
IF y%>ws%!16-toolh%-lh% AND ws%!24<0 THEN d%=lh%
IF d%=0 THEN ENDPROC
FOR i%=0 TO 28 STEP 4 : blk%!i%=ws%!i% : NEXT
blk%!24+=d%
IF blk%!24>0 THEN blk%!24=0
PROCopenmain
ENDPROC

REM Select the paragraph containing offset p%.
DEF PROCselpara(p%)
LOCAL a%,e%
a%=p% : e%=p%
WHILE a%>0 AND disp%?(a%-1)>4
  a%-=1
ENDWHILE
WHILE e%<displen% AND disp%?e%>4
  e%+=1
ENDWHILE
PROCsetsel(a%,e%)
ENDPROC

REM Change the selection to a% to e%, redrawing the lines that change.
DEF PROCsetsel(a%,e%)
LOCAL lo%,hi%
lo%=sels% : hi%=sels%
IF sele%<lo% THEN lo%=sele%
IF sele%>hi% THEN hi%=sele%
IF a%<lo% THEN lo%=a%
IF e%<lo% THEN lo%=e%
IF a%>hi% THEN hi%=a%
IF e%>hi% THEN hi%=e%
sels%=a% : sele%=e%
PROCredrawrange(lo%,hi%)
ENDPROC

REM Redraw the lines holding display offsets lo% to hi%.
DEF PROCredrawrange(lo%,hi%)
LOCAL a%,b%
a%=FNoffline(lo%) : b%=FNoffline(hi%)
IF a%<0 THEN a%=0
IF b%<0 THEN b%=nlines%-1
SYS "Wimp_ForceRedraw",mainw%,0,-(toolh%+8+(b%+1)*lh%),4000,-(toolh%+8+a%*lh%)
ENDPROC

REM Index of the text line holding offset o%, or -1.
DEF FNoffline(o%)
LOCAL i%,r%
r%=-1 : i%=0
WHILE r%<0 AND i%<nlines%
  IF ls%(i%)>=0 AND o%>=ls%(i%) AND o%<=ls%(i%)+ll%(i%) THEN r%=i%
  i%+=1
ENDWHILE
=r%

REM Display offset nearest the screen point x%,y% in the window.
DEF FNposat(x%,y%)
LOCAL ox%,oy%,d%,i%,j%,o%,c%,k%,w0%,w1%,s$
ws%!0=mainw% : SYS "Wimp_GetWindowState",,ws%
ox%=ws%!4-ws%!20 : oy%=ws%!16-ws%!24
d%=oy%-y%-toolh%-8
IF d%<0 THEN i%=0 ELSE i%=d% DIV lh%
o%=displen%
IF i%<nlines% THEN
  j%=i%
  WHILE j%<nlines% AND ls%(j%)<0
    j%+=1
  ENDWHILE
  IF j%<nlines% THEN
    o%=ls%(j%)
    IF j%=i% THEN
      c%=x%-ox%-margin% : k%=0 : w0%=0 : s$=""
      WHILE k%<ll%(i%) AND k%<255
        s$+=CHR$(disp%?(ls%(i%)+k%)) : w1%=FNwidth(s$)
        IF (w0%+w1%) DIV 2<=c% THEN k%+=1 : w0%=w1% ELSE k%=1000
      ENDWHILE
      IF k%=1000 THEN k%=LEN s$-1
      o%=ls%(i%)+k%
    ENDIF
  ENDIF
ENDIF
=o%

REM TRUE if the selection overlaps n% bytes at offset s%.
DEF FNoverlap(s%,n%)
LOCAL lo%,hi%
lo%=sels% : hi%=sele%
IF hi%<lo% THEN lo%=sele% : hi%=sels%
=(lo%<hi% AND lo%<s%+n% AND hi%>s%)

REM Paint text line a% (text s$ at x%,y%) with the selected part shown
REM on a highlight.
DEF PROCpaintsel(a%,s$,x%,y%)
LOCAL lo%,hi%,b%,e%,w0%,w1%,t0$,t1$,t2$
lo%=sels% : hi%=sele%
IF hi%<lo% THEN lo%=sele% : hi%=sels%
b%=lo%-ls%(a%) : e%=hi%-ls%(a%)
IF b%<0 THEN b%=0
IF e%>LEN s$ THEN e%=LEN s$
t0$=LEFT$(s$,b%) : t1$=MID$(s$,b%+1,e%-b%) : t2$=MID$(s$,e%+1)
w0%=FNwidth(t0$) : w1%=FNwidth(t0$+t1$)
SYS "ColourTrans_SetGCOL",&FFDDBB00,,,0,0
RECTANGLE FILL x%+w0%,y%-10,w1%-w0%,lh%
SYS "Wimp_TextOp",0,FNcolour(ls%(a%),lc%(a%)),&FFFFFF00
IF t0$<>"" THEN SYS "Wimp_TextOp",2,t0$,-1,-1,x%,y%
IF t2$<>"" THEN SYS "Wimp_TextOp",2,t2$,-1,-1,x%+w1%,y%
SYS "Wimp_TextOp",0,FNcolour(ls%(a%),lc%(a%)),&FFDDBB00
SYS "Wimp_TextOp",2,t1$,-1,-1,x%+w0%,y%
ENDPROC

REM Copy the selection to the clipboard: build it as text in clip%,
REM then tell other applications that Claude now owns the clipboard.
DEF PROCcopy
LOCAL lo%,hi%,c%
lo%=sels% : hi%=sele%
IF hi%<lo% THEN lo%=sele% : hi%=sels%
IF lo%=hi% THEN ENDPROC
cliplen%=0
WHILE lo%<hi%
  c%=disp%?lo%
  IF c%<5 THEN
    IF cliplen%>0 THEN clip%?cliplen%=10 : clip%?(cliplen%+1)=10 : cliplen%+=2
  ELSE
    clip%?cliplen%=c% : cliplen%+=1
  ENDIF
  lo%+=1
ENDWHILE
mb%!0=24 : mb%!12=0 : mb%!16=&F : mb%!20=4
SYS "Wimp_SendMessage",17,mb%,0
haveclip%=TRUE
ENDPROC

REM Another application wants to paste: offer it the clipboard as Text,
REM using the same Message_DataSave protocol as a drag to save.
DEF PROCdatarequest
IF NOT haveclip% OR (blk%!36 AND 4)=0 THEN ENDPROC
blk%!12=blk%!8 : blk%!16=1
blk%!36=cliplen% : blk%!40=&FFF
$(blk%+44)="Clipboard" : blk%?53=0
blk%!0=56
SYS "Wimp_SendMessage",18,blk%,blk%!4
saveout%=blk%!8 : saveclip%=TRUE
ENDPROC

REM ---------------------------------------------------------------
REM Token usage and credit estimate
REM Each reply's "usage" gives input and output tokens. They are added
REM to this conversation's totals and to the totals since the credit
REM balance was last set. With prices entered, the Usage window shows an
REM estimated cost and how much credit is left. The Anthropic API has no
REM way to read the real balance, so this is only ever an estimate.
REM ---------------------------------------------------------------

REM Add the usage in the reply in resp% to the totals; note it if wanted.
DEF PROCcountusage
LOCAL i%,o%
i%=FNnumkey("input_tokens") : o%=FNnumkey("output_tokens")
IF i%<0 OR o%<0 THEN ENDPROC
sessin%+=i% : sessout%+=o% : totin%+=i% : totout%+=o%
PROCsavechoices
PROCusagefields
IF showusage% THEN PROCnote(FNcommas(i%)+" tokens in, "+FNcommas(o%)+" out"+FNcostnote(i%,o%)+".")
ENDPROC

REM Value of the numeric JSON field k$ in resp%, or -1 if absent.
DEF FNnumkey(k$)
LOCAL q$,p%,j%,v%,r%
q$=""""+k$+"""" : p%=0 : r%=-1
WHILE r%<0 AND p%<resplen%
  IF resp%?p%=34 THEN
    IF FNmatch(p%,q$) THEN
      j%=FNskipws(p%+LEN q$)
      IF resp%?j%=58 THEN
        j%=FNskipws(j%+1) : v%=0
        IF resp%?j%>=48 AND resp%?j%<=57 THEN
          WHILE resp%?j%>=48 AND resp%?j%<=57
            v%=v%*10+resp%?j%-48 : j%+=1
          ENDWHILE
          r%=v%
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  p%+=1
ENDWHILE
=r%

REM Estimated cost in dollars of i% input and o% output tokens, or -1
REM if the prices have not been entered.
DEF FNcost(i%,o%)
LOCAL c
c=-1
IF pin$<>"" AND pout$<>"" THEN c=i%*VAL(pin$)/1E6+o%*VAL(pout$)/1E6
=c

REM ", about $x" for i% and o% tokens, or "" without prices.
DEF FNcostnote(i%,o%)
LOCAL s$
s$=""
IF FNcost(i%,o%)>=0 THEN s$=", about "+FNmoney(FNcost(i%,o%))
=s$

REM x dollars as $d.cc, rounded to the nearest cent.
DEF FNmoney(x)
LOCAL c%,s$
s$="$"
IF x<0 THEN s$="-$" : x=-x
c%=INT(x*100+0.5)
=s$+STR$(c% DIV 100)+"."+RIGHT$("0"+STR$(c% MOD 100),2)

REM n% with commas between thousands.
DEF FNcommas(n%)
LOCAL s$,t$
s$=STR$n% : t$=""
WHILE LEN s$>3
  t$=","+RIGHT$(s$,3)+t$ : s$=LEFT$(s$,LEN s$-3)
ENDWHILE
=s$+t$

REM Today's date, such as "10 Nov 2026".
DEF FNtoday
=MID$(TIME$,5,11)

REM Fill the Usage window's display fields and redraw them.
DEF PROCusagefields
LOCAL c
$usebuf1%=FNcommas(sessin%)+" in, "+FNcommas(sessout%)+" out"+FNcostnote(sessin%,sessout%)
IF creditdate$="" THEN $usebuf2%=FNcommas(totin%)+" in, "+FNcommas(totout%)+" out"+FNcostnote(totin%,totout%) ELSE $usebuf2%=FNcommas(totin%)+" in, "+FNcommas(totout%)+" out since "+creditdate$+FNcostnote(totin%,totout%)
c=FNcost(totin%,totout%)
CASE TRUE OF
  WHEN credit$="" : $usebuf3%="Enter your credit balance below."
  WHEN c<0 : $usebuf3%="Enter the prices below to estimate it."
  OTHERWISE $usebuf3%="About "+FNmoney(VAL(credit$)-c)+" of "+FNmoney(VAL(credit$))+" (estimate)"
ENDCASE
PROCredrawicon(usew%,1) : PROCredrawicon(usew%,3) : PROCredrawicon(usew%,5)
ENDPROC

REM Put the stored credit and prices into the writable fields.
DEF PROCfillusage
$credbuf%=credit$ : $pinbuf%=pin$ : $poutbuf%=pout$
PROCredrawicon(usew%,7) : PROCredrawicon(usew%,9) : PROCredrawicon(usew%,11)
ENDPROC

REM Open the Usage window at the front.
DEF PROCopenusage
PROCfillusage : PROCusagefields
blk%!0=usew% : SYS "Wimp_GetWindowState",,blk%
blk%!28=-1 : SYS "Wimp_OpenWindow",,blk%
SYS "Wimp_SetCaretPosition",usew%,7,0,0,-1,LEN credit$
ENDPROC

REM Set: store the credit and prices. A new credit balance restarts the
REM totals from today. SELECT (b%=4) also closes the window.
DEF PROCusageset(b%)
LOCAL c$
c$=FNtrim(FNcstr(credbuf%))
pin$=FNtrim(FNcstr(pinbuf%)) : pout$=FNtrim(FNcstr(poutbuf%))
IF c$<>credit$ THEN credit$=c$ : creditdate$=FNtoday : totin%=0 : totout%=0
PROCsavechoices
PROCusagefields
IF b%<>1 THEN blk2%!0=usew% : SYS "Wimp_CloseWindow",,blk2%
ENDPROC

REM Cancel: SELECT closes the window, ADJUST restores the stored values.
DEF PROCusagecancel(b%)
IF b%=1 THEN PROCfillusage ELSE blk2%!0=usew% : SYS "Wimp_CloseWindow",,blk2%
ENDPROC

REM ---------------------------------------------------------------
REM Update check
REM At start-up, if enabled in Choices, curl fetches the latest release
REM from the GitHub API in a TaskWindow. If its version is newer than
REM this one and the user has not chosen to skip it, the Update
REM available box offers to open the Releases page in a browser.
REM Any failure is silent: the check must never get in the way.
REM ---------------------------------------------------------------

REM Start fetching the latest release details, if curl is available.
DEF PROCstartupdatecheck
LOCAL f%
IF NOT FNcurlfound THEN ENDPROC
PROCdelupdate
f%=OPENOUT updcfg$
PROCline(f%,"url = ""https://api.github.com/repos/"+updrepo$+"/releases/latest""")
PROCline(f%,"header = ""Accept: application/vnd.github+json""")
PROCline(f%,"user-agent = ""Claude-RISCOS/"+FNmyversion+"""")
PROCline(f%,"output = """+updout$+"""")
PROCline(f%,"silent")
PROCline(f%,"max-time = 30")
IF cert$<>"" THEN PROCline(f%,"cacert = """+cert$+"""")
CLOSE#f%
f%=OPENOUT updobey$
PROCline(f%,"curl -K "+updcfg$)
PROCline(f%,"Create "+upddone$)
CLOSE#f%
SYS "XWimp_StartTask","TaskWindow ""Obey "+updobey$+""" -name ""Claude update check"" -wimpslot 8192K -quit"
SYS "OS_ReadMonotonicTime" TO checkstart%
checking%=TRUE
ENDPROC

REM On each null event, look for the result; give up after a minute.
DEF PROCcheckupdate
LOCAL t%,n%,p%,tag$
IF NOT checking% THEN ENDPROC
SYS "OS_ReadMonotonicTime" TO t%
IF FNlen(upddone$)<0 THEN
  IF t%-checkstart%>6000 THEN checking%=FALSE : PROCdelupdate
  ENDPROC
ENDIF
checking%=FALSE
n%=FNlen(updout$)
IF n%>0 AND n%<bufsize% THEN
  SYS "OS_File",255,updout$,resp%,0
  resp%?n%=0 : resplen%=n%
  p%=FNfindkey("tag_name",0)
  IF p%>=0 THEN tag$=FNjson(p%)
ENDIF
PROCdelupdate
IF FNupdatewanted(tag$) THEN PROCshowupdate(tag$)
ENDPROC

REM TRUE if release tag t$ is newer than this version and not skipped.
DEF FNupdatewanted(t$)
LOCAL w%
w%=FALSE
IF t$<>"" AND t$<>skiptag$ THEN w%=(FNvernum(t$)>FNvernum(version$))
=w%

REM Open the Update available box for release tag t$.
DEF PROCshowupdate(t$)
newtag$=t$
$updmsg%="Claude "+MID$(t$,FNdigit(t$))+" is available. You have "+FNmyversion+"."
PROCredrawicon(updw%,0)
PROCsetselected(updw%,2,FALSE)
blk%!0=updw% : SYS "Wimp_GetWindowState",,blk%
blk%!28=-1 : SYS "Wimp_OpenWindow",,blk%
ENDPROC

REM This version's number, without its date.
DEF FNmyversion
=LEFT$(version$,INSTR(version$," ")-1)

REM Position of the first digit in s$, or LEN s$+1 if none.
DEF FNdigit(s$)
LOCAL i%
i%=1
WHILE i%<=LEN s$ AND (MID$(s$,i%,1)<"0" OR MID$(s$,i%,1)>"9")
  i%+=1
ENDWHILE
=i%

REM Version number in s$: the number starting at its first digit.
DEF FNvernum(s$)
=VAL(MID$(s$,FNdigit(s$)))

REM Close the Update available box, remembering to skip this update
REM if its tick box is ticked.
DEF PROCupdatelater
IF FNselected(updw%,2) THEN skiptag$=newtag$ : PROCsavechoices
blk2%!0=updw% : SYS "Wimp_CloseWindow",,blk2%
ENDPROC

REM Open the Releases page in the user's browser, then close the box.
REM Put the Releases page address on the clipboard, close the box and
REM say so. Opening a browser automatically proved unreliable, so the
REM user pastes the address instead.
DEF PROCupdatedownload
url$="https://github.com/"+updrepo$+"/releases/latest"
PROCurlclip
PROCupdatelater
PROCwarn("The Releases page address is on the clipboard. Paste it into your web browser to download the new version: "+url$)
ENDPROC

REM Put url$ on the clipboard.
DEF PROCurlclip
LOCAL i%
FOR i%=1 TO LEN url$ : clip%?(i%-1)=ASC MID$(url$,i%,1) : NEXT
cliplen%=LEN url$
mb%!0=24 : mb%!12=0 : mb%!16=&F : mb%!20=4
SYS "Wimp_SendMessage",17,mb%,0
haveclip%=TRUE
ENDPROC

REM Delete the update check's scrap files.
DEF PROCdelupdate
SYS "XOS_File",6,updcfg$ : SYS "XOS_File",6,updobey$
SYS "XOS_File",6,updout$ : SYS "XOS_File",6,upddone$
ENDPROC

REM ---------------------------------------------------------------
REM Receiving the reply
REM ---------------------------------------------------------------

REM On each null event, look for the marker file or give up after 3 min.
DEF PROCcheckreply
LOCAL t%
IF NOT busy% THEN ENDPROC
IF FNlen(done$)>=0 THEN PROCfinish : ENDPROC
SYS "OS_ReadMonotonicTime" TO t%
IF t%-started%>18000 THEN PROCfail("No reply after three minutes. Check that curl is installed and on Run$Path.")
ENDPROC

REM Load curl's output and parse it.
DEF PROCfinish
LOCAL n%
busy%=FALSE : PROCbusyui
n%=FNlen(out$)
IF n%<=0 THEN PROCfail("curl: "+FNsmall(err$)) : ENDPROC
IF n%>=bufsize% THEN PROCfail("The reply is too large to display.") : ENDPROC
SYS "OS_File",255,out$,resp%,0
resp%?n%=0 : resplen%=n%
PROCdelscratch
PROCparse
PROCrefresh
ENDPROC

REM Show error m$, drop the unanswered message from the history.
DEF PROCfail(m$)
busy%=FALSE : PROCbusyui
PROCdelscratch
histlen%=prevhist%
PROCdispbyte(3) : PROCdispstr(m$)
PROCrefresh
ENDPROC

REM Pull the text blocks out of the Messages API reply in resp%.
DEF PROCparse
LOCAL p%,e%,got%
p%=FNfindkey("type",0)
IF p%>=0 THEN
  IF FNmatch(p%,"error""") THEN
    e%=FNfindkey("message",p%)
    IF e%>=0 THEN PROCfail("API: "+FNjson(e%)) ELSE PROCfail("API error: "+FNpreview)
    ENDPROC
  ENDIF
ENDIF
got%=FALSE : p%=0
REPEAT
  p%=FNfindkey("text",p%)
  IF p%>=0 THEN
    e%=FNstrend(p%)
    IF NOT got% THEN PROChistbegin(2) : PROCdispbyte(2) : got%=TRUE
    PROChistcopy(p%,e%)
    PROCdecode(p%,e%)
    p%=e%+1
  ENDIF
UNTIL p%<0
IF NOT got% THEN PROCfail("Unexpected reply: "+FNpreview) : ENDPROC
PROChistend
PROCclearatt
PROCcountusage
p%=FNfindkey("stop_reason",0)
IF p%>=0 THEN IF FNmatch(p%,"max_tokens") THEN PROCdispbyte(3) : PROCdispstr("The reply reached the 4096-token limit and stopped early.")
ENDPROC

REM Find "k$": "  in resp% from offset p%. Return the offset of the
REM string value's first character, or -1.
DEF FNfindkey(k$,p%)
LOCAL q$,n%,i%,j%,ok%,r%
q$=""""+k$+"""" : n%=LEN q$ : r%=-1
WHILE r%<0 AND p%+n%<=resplen%
  IF resp%?p%=34 THEN
    ok%=TRUE : i%=1
    WHILE ok% AND i%<n%
      IF resp%?(p%+i%)<>ASC MID$(q$,i%+1,1) THEN ok%=FALSE
      i%+=1
    ENDWHILE
    IF ok% THEN
      j%=FNskipws(p%+n%)
      IF resp%?j%=58 THEN
        j%=FNskipws(j%+1)
        IF resp%?j%=34 THEN r%=j%+1
      ENDIF
    ENDIF
  ENDIF
  p%+=1
ENDWHILE
=r%

REM Skip JSON whitespace from offset p%.
DEF FNskipws(p%)
WHILE p%<resplen% AND (resp%?p%=32 OR resp%?p%=9 OR resp%?p%=10 OR resp%?p%=13)
  p%+=1
ENDWHILE
=p%

REM Return the offset of the quote that ends the string starting at p%.
DEF FNstrend(p%)
WHILE p%<resplen% AND resp%?p%<>34
  IF resp%?p%=92 THEN p%+=2 ELSE p%+=1
ENDWHILE
=p%

REM TRUE if resp% holds s$ at offset p%.
DEF FNmatch(p%,s$)
LOCAL i%,ok%
ok%=TRUE
FOR i%=1 TO LEN s$
  IF resp%?(p%+i%-1)<>ASC MID$(s$,i%,1) THEN ok%=FALSE
NEXT
=ok%

REM Decode the JSON string at p% into a BASIC string of up to 200 chars.
DEF FNjson(p%)
LOCAL s$,c%
s$=""
WHILE p%<resplen% AND resp%?p%<>34 AND LEN s$<200
  c%=resp%?p%
  IF c%=92 THEN p%+=1 : c%=resp%?p% : IF c%=110 THEN c%=32
  IF c%>=128 THEN c%=63
  s$+=CHR$c% : p%+=1
ENDWHILE
=s$

REM First 150 bytes of the reply, for errors nobody planned for.
DEF FNpreview
LOCAL s$,i%,c%
s$="" : i%=0
WHILE i%<resplen% AND i%<150
  c%=resp%?i% : IF c%<32 OR c%>=127 THEN c%=32
  s$+=CHR$c% : i%+=1
ENDWHILE
=s$

REM First 200 bytes of file f$, or a hint if it is missing or empty.
DEF FNsmall(f$)
LOCAL f%,s$,c%
s$="no reply and no error text. Check that curl is installed and on Run$Path."
IF FNlen(f$)>0 THEN
  f%=OPENIN f$ : s$=""
  WHILE NOT EOF#f% AND LEN s$<200
    c%=BGET#f% : IF c%<32 THEN c%=32
    s$+=CHR$c%
  ENDWHILE
  CLOSE#f%
ENDIF
=s$

REM Decode the JSON string between p% and e% into the display buffer.
DEF PROCdecode(p%,e%)
LOCAL c%,d%,u%,k%
WHILE p%<e%
  c%=resp%?p%
  IF c%=92 THEN
    d%=resp%?(p%+1) : p%+=2
    CASE d% OF
      WHEN 110 : PROCdispcode(10)
      WHEN 116 : PROCdispcode(9)
      WHEN 114,98,102 : REM \r \b \f: drop
      WHEN 117 :
        u%=EVAL("&"+FNbytes(p%,4)) : p%+=4
        IF u%>=&D800 AND u%<=&DBFF THEN u%=&FFFD : IF resp%?p%=92 THEN p%+=6
        PROCdispcode(u%)
      OTHERWISE PROCdispcode(d%)
    ENDCASE
  ELSE
    IF c%<128 THEN
      PROCdispcode(c%) : p%+=1
    ELSE
      CASE TRUE OF
        WHEN c%>=&F0 : u%=c% AND 7 : k%=3
        WHEN c%>=&E0 : u%=c% AND 15 : k%=2
        WHEN c%>=&C0 : u%=c% AND 31 : k%=1
        OTHERWISE u%=&FFFD : k%=0
      ENDCASE
      p%+=1
      WHILE k%>0 AND p%<e%
        u%=(u%<<6) OR (resp%?p% AND 63) : p%+=1 : k%-=1
      ENDWHILE
      PROCdispcode(u%)
    ENDIF
  ENDIF
ENDWHILE
ENDPROC

REM n% bytes of resp% from p% as a string.
DEF FNbytes(p%,n%)
LOCAL s$
s$=""
WHILE n%>0
  s$+=CHR$(resp%?p%) : p%+=1 : n%-=1
ENDWHILE
=s$

REM Add Unicode character u% to the display buffer as Latin-1, with
REM ASCII stand-ins for common typography and "?" for the rest.
DEF PROCdispcode(u%)
CASE TRUE OF
  WHEN u%=10 : PROCdispbyte(10)
  WHEN u%=9 : PROCdispstr("    ")
  WHEN u%<32 : REM other control characters: drop
  WHEN u%<128 : PROCdispbyte(u%)
  WHEN u%<160 : PROCdispbyte(63)
  WHEN u%<256 : PROCdispbyte(u%)
  WHEN u%=&2018 OR u%=&2019 : PROCdispbyte(39)
  WHEN u%=&201C OR u%=&201D : PROCdispbyte(34)
  WHEN u%=&2013 OR u%=&2014 OR u%=&2212 : PROCdispbyte(45)
  WHEN u%=&2026 : PROCdispstr("...")
  WHEN u%=&2022 : PROCdispbyte(42)
  OTHERWISE PROCdispbyte(63)
ENDCASE
ENDPROC

REM ---------------------------------------------------------------
REM Conversation history (JSON-ready, sent with every request)
REM Record: role byte (1 user, 2 assistant), 3 pad bytes, length word,
REM then the escaped JSON string content, padded to a word boundary.
REM ---------------------------------------------------------------

DEF PROChistbegin(role%)
recstart%=histlen% : hist%?recstart%=role% : histlen%+=8
ENDPROC

DEF PROChistadd(c%)
IF histlen%>=bufsize%-16 THEN ERROR 1,"The conversation is too long. Choose Clear from the menu."
hist%?histlen%=c% : histlen%+=1
ENDPROC

DEF PROChistend
hist%!(recstart%+4)=histlen%-recstart%-8
histlen%=(histlen%+3) AND NOT 3
ENDPROC

REM Add n% Latin-1 bytes from a% with JSON escaping.
DEF PROChistesc(a%,n%)
LOCAL i%,c%,s$,j%
i%=0
WHILE i%<n%
  c%=a%?i%
  CASE TRUE OF
    WHEN c%=34 OR c%=92 : PROChistadd(92) : PROChistadd(c%)
    WHEN c%<32 OR c%>=128 :
      s$="\u"+RIGHT$("000"+STR$~c%,4)
      FOR j%=1 TO 6 : PROChistadd(ASC MID$(s$,j%,1)) : NEXT
    OTHERWISE PROChistadd(c%)
  ENDCASE
  i%+=1
ENDWHILE
ENDPROC

REM Copy reply bytes p% to e% unchanged: they are already JSON.
DEF PROChistcopy(p%,e%)
WHILE p%<e%
  PROChistadd(resp%?p%) : p%+=1
ENDWHILE
ENDPROC

REM ---------------------------------------------------------------
REM Display buffer and layout
REM Paragraphs start with a marker byte: 1 you, 2 Claude, 3 error.
REM Lines: ls% start offset (-1 heading, -2 blank), ll% length, lc% colour.
REM ---------------------------------------------------------------

DEF PROCdispbyte(c%)
IF displen%<bufsize%-8 THEN disp%?displen%=c% : displen%+=1
ENDPROC

DEF PROCdispstr(s$)
LOCAL i%
IF s$="" THEN ENDPROC
FOR i%=1 TO LEN s$ : PROCdispbyte(ASC MID$(s$,i%,1)) : NEXT
ENDPROC

REM Empty the conversation, unless a request is running.
DEF PROCclear
IF busy% THEN ENDPROC
histlen%=0 : displen%=0 : sels%=0 : sele%=0 : sessin%=0 : sessout%=0
PROCusagefields
PROCdropsent
PROCrefresh
ENDPROC

REM Rewrap, then scroll to the newest text if the window is open.
DEF PROCrefresh
IF lastw%=0 THEN ENDPROC
PROCrewrap
PROCscrollend
ENDPROC

REM Break the display buffer into lines that fit the window width.
DEF PROCrewrap
LOCAL p%,c%,e%,col%
avail%=lastw%-2*margin%
nlines%=0 : p%=0
WHILE p%<displen%
  c%=disp%?p% : p%+=1 : e%=p%
  WHILE e%<displen% AND disp%?e%>4
    e%+=1
  ENDWHILE
  col%=0 : IF c%=3 OR c%=4 THEN col%=c%
  IF c%<>4 THEN PROCaddline(-1,0,c%)
  PROCwrappara(p%,e%,col%)
  PROCaddline(-2,0,0)
  p%=e%
ENDWHILE
PROCsetextent
SYS "Wimp_ForceRedraw",mainw%,0,-&1000000,4000,0
ENDPROC

REM Wrap one paragraph (offsets s% to e%) at spaces where possible.
DEF PROCwrappara(s%,e%,col%)
LOCAL p%,st%,sp%,l$,c%,brk%
p%=s% : st%=s% : sp%=-1 : l$=""
WHILE p%<e%
  c%=disp%?p%
  IF c%=10 THEN
    PROCaddline(st%,p%-st%,col%) : p%+=1 : st%=p% : sp%=-1 : l$=""
  ELSE
    IF LEN l$>=250 THEN brk%=TRUE ELSE brk%=(FNwidth(l$+CHR$c%)>avail%)
    IF brk% AND p%>st% THEN
      IF sp%>st% THEN
        PROCaddline(st%,sp%-st%,col%) : p%=sp%+1
      ELSE
        PROCaddline(st%,p%-st%,col%)
      ENDIF
      st%=p% : sp%=-1 : l$=""
    ELSE
      l$+=CHR$c% : IF c%=32 THEN sp%=p%
      p%+=1
    ENDIF
  ENDIF
ENDWHILE
IF p%>st% THEN PROCaddline(st%,p%-st%,col%)
ENDPROC

DEF PROCaddline(s%,n%,c%)
IF nlines%<maxl% THEN ls%(nlines%)=s% : ll%(nlines%)=n% : lc%(nlines%)=c% : nlines%+=1
ENDPROC

REM Width of s$ in the desktop font, in OS units.
DEF FNwidth(s$)
LOCAL w%
SYS "Wimp_TextOp",1,s$,0 TO w%
=w%

REM Size the work area to the text, never smaller than the window.
DEF PROCsetextent
LOCAL h%
ws%!0=mainw% : SYS "Wimp_GetWindowState",,ws%
h%=toolh%+16+nlines%*lh%
IF h%<ws%!16-ws%!8 THEN h%=ws%!16-ws%!8
ext%!0=0 : ext%!4=-h% : ext%!8=2000 : ext%!12=0
SYS "Wimp_SetExtent",mainw%,ext%
ENDPROC

REM Scroll the open conversation window to its last line.
DEF PROCscrollend
LOCAL i%
ws%!0=mainw% : SYS "Wimp_GetWindowState",,ws%
IF (ws%!32 AND (1<<16))=0 THEN ENDPROC
FOR i%=0 TO 28 STEP 4 : blk%!i%=ws%!i% : NEXT
blk%!24=-(toolh%+16+nlines%*lh%)
PROCopenmain
ENDPROC

REM Paint the visible lines in the desktop font.
DEF PROCredraw
LOCAL more%,ox%,oy%,a%,b%,y%,s$
SYS "Wimp_RedrawWindow",,blk% TO more%
WHILE more%
  ox%=blk%!4-blk%!20 : oy%=blk%!16-blk%!24
  a%=(oy%-blk%!40-toolh%-8) DIV lh%
  b%=(oy%-blk%!32-toolh%-8) DIV lh%
  IF a%<0 THEN a%=0
  IF b%>nlines%-1 THEN b%=nlines%-1
  WHILE a%<=b%
    s$=""
    CASE TRUE OF
      WHEN ls%(a%)>=0 : s$=FNline(ls%(a%),ll%(a%))
      WHEN ls%(a%)=-1 : s$=FNhead(lc%(a%))
    ENDCASE
    IF s$<>"" THEN
      y%=oy%-toolh%-8-(a%+1)*lh%+10
      IF ls%(a%)>=0 AND FNoverlap(ls%(a%),ll%(a%)) THEN
        PROCpaintsel(a%,s$,ox%+margin%,y%)
      ELSE
        SYS "Wimp_TextOp",0,FNcolour(ls%(a%),lc%(a%)),&FFFFFF00
        SYS "Wimp_TextOp",2,s$,-1,-1,ox%+margin%,y%
      ENDIF
    ENDIF
    a%+=1
  ENDWHILE
  SYS "Wimp_GetRectangle",,blk% TO more%
ENDWHILE
ENDPROC

REM Display line text: n% bytes of disp% from s%.
DEF FNline(s%,n%)
LOCAL l$
l$=""
IF n%>255 THEN n%=255
WHILE n%>0
  l$+=CHR$(disp%?s%) : s%+=1 : n%-=1
ENDWHILE
=l$

DEF FNhead(c%)
LOCAL h$
h$="Error"
IF c%=1 THEN h$="You"
IF c%=2 THEN h$="Claude"
=h$

REM Colour as &BBGGRR00: blue for you, orange for Claude, red errors.
DEF FNcolour(s%,c%)
LOCAL k%
k%=0
IF c%=3 THEN k%=&0000CC00
IF c%=4 THEN k%=&77777700
IF s%=-1 AND c%=1 THEN k%=&99442200
IF s%=-1 AND c%=2 THEN k%=&3264C800
=k%

REM ---------------------------------------------------------------
REM Utilities
REM ---------------------------------------------------------------

REM Length of a control-terminated string at a%.
DEF FNclen(a%)
LOCAL n%
n%=0
WHILE a%?n%>=32
  n%+=1
ENDWHILE
=n%

REM Control-terminated string at a% as a BASIC string (max 255).
DEF FNcstr(a%)
LOCAL s$
s$=""
WHILE a%?0>=32 AND LEN s$<255
  s$+=CHR$(a%?0) : a%+=1
ENDWHILE
=s$

DEF FNtrim(s$)
WHILE LEFT$(s$,1)=" "
  s$=MID$(s$,2)
ENDWHILE
WHILE RIGHT$(s$,1)=" "
  s$=LEFT$(s$,LEN s$-1)
ENDWHILE
=s$

REM Length of file f$, or -1 if it is not a file.
DEF FNlen(f$)
LOCAL t%,l%
SYS "XOS_File",17,f$ TO t%,,,,l%
IF t%<>1 THEN l%=-1
=l%

DEF PROCput(f%,s$)
LOCAL i%
FOR i%=1 TO LEN s$ : BPUT#f%,ASC MID$(s$,i%,1) : NEXT
ENDPROC

DEF PROCline(f%,s$)
PROCput(f%,s$) : BPUT#f%,10
ENDPROC

REM Delete the scrap files, including the config holding the API key.
DEF PROCdelscratch
SYS "XOS_File",6,req$ : SYS "XOS_File",6,cfg$ : SYS "XOS_File",6,obey$
SYS "XOS_File",6,out$ : SYS "XOS_File",6,err$ : SYS "XOS_File",6,done$
ENDPROC

REM Build a RISC OS error block holding m$.
DEF FNerr(m$)
m$=LEFT$(m$,250)
!errblk%=0 : $(errblk%+4)=m$ : errblk%?(4+LEN m$)=0
=errblk%

REM Show warning m$ with an OK button and no "Error from" prefix.
DEF PROCwarn(m$)
SYS "Wimp_ReportError",FNerr(m$),1+16,app$
ENDPROC

DEF PROCreport(m$)
SYS "Wimp_ReportError",FNerr(m$),1,app$
ENDPROC

REM Report an error; Cancel quits, OK carries on.
DEF PROCerror
LOCAL r%
SYS "XHourglass_Smash"
SYS "Wimp_ReportError",FNerr(REPORT$+" (line "+STR$ERL+")"),3,app$ TO ,r%
IF r%=2 THEN quit%=TRUE
ENDPROC

DEF PROCcleanup
IF scrap$<>"" THEN PROCdelscratch : PROCdelupdate
IF task%<>0 THEN SYS "Wimp_CloseDown",task%,&4B534154
ENDPROC
