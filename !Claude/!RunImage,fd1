REM >!RunImage for !Claude
REM A RISC OS desktop client for the Anthropic Messages API.
REM 0.10 (10 Nov 2026).
REM Requests go through curl in a TaskWindow, so the desktop keeps
REM multitasking while Claude replies.

task%=0 : scrap$=""
DIM errblk% 260
ON ERROR SYS "Wimp_ReportError",FNerr(REPORT$+" (line "+STR$ERL+")"),1,"Claude" : PROCcleanup : END
PROCinit
ON ERROR PROCerror
WHILE NOT quit%
  PROCpoll
ENDWHILE
PROCcleanup
END

REM ---------------------------------------------------------------
REM Start-up
REM ---------------------------------------------------------------

REM Set constants, claim buffers, start the Wimp task and build the UI.
DEF PROCinit
app$="Claude" : version$="0.10 (10 Nov 2026)"
toolh%=96 : lh%=40 : margin%=16 : maxl%=8000 : bufsize%=256*1024
quit%=FALSE : busy%=FALSE : lastw%=0 : avail%=0 : started%=0
DIM blk% 1024, blk2% 64, ws% 64, ext% 16, ptr% 32
DIM inbuf% 1024, keybuf% 256, modelbuf% 64, certbuf% 256, titlebuf% 64
REM Attachments: entries 0 to firstpend%-1 have been sent and are kept
REM so they can be saved again; firstpend% to natt%-1 are waiting to be
REM sent. Up to maxatt% can wait at once and keepmax% can be held.
maxatt%=8 : keepmax%=32 : attmax%=3*1024*1024
DIM attbuf% attmax%, pathbuf% 256, attlist% 256, tmpbuf% 256
DIM attname$(keepmax%), attkind%(keepmax%), attmedia$(keepmax%), attoff%(keepmax%), attlen%(keepmax%), attftype%(keepmax%)
DIM attmtext% 64*keepmax%
natt%=0 : firstpend%=0 : attused%=0 : saveref%=0 : saveleaf$="" : ?pathbuf%=0
REM Selection in the conversation (display buffer offsets) and clipboard.
sels%=0 : sele%=0 : selecting%=FALSE
DIM clip% bufsize%, mb% 64
url$=""
cliplen%=0 : haveclip%=FALSE : saveclip%=FALSE
DIM b64tab% 64, b64buf% 65536
REM Saving: sav% holds the text being saved, built when a Save submenu opens.
DIM sav% bufsize%, savenamebuf% 256, sprname% 16, drag% 40
savelen%=0 : savetype%=&FFF : saveout%=0 : dragging%=FALSE : savesrc%=sav%
REM Update check: the GitHub repository whose latest release is checked.
updrepo$="markee174/claude-riscos-client"
checking%=FALSE : checkstart%=0 : newtag$=""
DIM updmsg% 128
REM Token usage: this conversation, and since the credit balance was set.
sessin%=0 : sessout%=0
DIM usebuf1% 100, usebuf2% 100, usebuf3% 100, credbuf% 16, pinbuf% 16, poutbuf% 16
$b64tab%="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
DIM hist% bufsize%, disp% bufsize%, resp% bufsize%
DIM ls%(maxl%), ll%(maxl%), lc%(maxl%)
histlen%=0 : displen%=0 : resplen%=0 : nlines%=0 : recstart%=0 : prevhist%=0
?inbuf%=0 : $titlebuf%=app$
PROCloadchoices
DIM msgs% 32 : msgs%!0=1 : msgs%!4=2 : msgs%!8=3 : msgs%!12=&F : msgs%!16=&10 : msgs%!20=&502 : msgs%!24=&400C0 : msgs%!28=0
SYS "Wimp_Initialise",380,&4B534154,app$,msgs% TO ,task%
PROCscratch
PROCcreatewindows
PROCcreatemenus
PROCiconbar
PROCsetattlist
PROCstartupchecks
IF checkupd% THEN PROCstartupdatecheck
ENDPROC

REM Warn if the API key is missing or curl cannot be found. Each check
REM shows its own dialogue; the app carries on running either way.
DEF PROCstartupchecks
IF key$="" THEN PROCwarn("No API key is set. Choose Choices from the Claude icon bar menu and paste in your Anthropic API key.")
IF NOT FNcurlfound THEN PROCwarn("curl was not found, so Claude cannot send messages. Install curl with PackMan (add the riscos.info source first), or set Alias$curl to point to it.")
ENDPROC

REM TRUE if curl is set up as an alias or is a file on Run$Path.
DEF FNcurlfound
LOCAL t%,found%
found%=FALSE
SYS "XOS_ReadVarVal","Alias$curl",blk%,-1,0,0 TO ,,t%
IF t%<>0 THEN found%=TRUE
IF NOT found% THEN
  SYS "XOS_File",15,"curl",,,"Run$Path" TO t%
  IF t%=1 OR t%=3 THEN found%=TRUE
ENDIF
=found%

REM Create the scrap directory and work out canonical names for the
REM files shared with curl.
DEF PROCscratch
LOCAL t%
SYS "XOS_ReadVarVal","Wimp$ScrapDir",blk%,-1,0,0 TO ,,t%
IF t%=0 THEN ERROR 1,"Wimp$ScrapDir is not set, so Claude has nowhere to put temporary files."
SYS "OS_File",8,"<Wimp$ScrapDir>.Claude",,,0
scrap$=FNcanon("<Wimp$ScrapDir>.Claude")
req$=scrap$+".Request" : cfg$=scrap$+".Config" : obey$=scrap$+".Fetch"
out$=scrap$+".Reply" : err$=scrap$+".Errors" : done$=scrap$+".Done"
updcfg$=scrap$+".UpdConfig" : updobey$=scrap$+".UpdFetch" : updout$=scrap$+".UpdReply" : upddone$=scrap$+".UpdDone"
ENDPROC

REM Return the canonical form of path p$.
DEF FNcanon(p$)
SYS "OS_FSControl",37,p$,blk%,0,0,1024
=FNcstr(blk%)

