REM Fill blk% with a window definition. tptr% is an indirected title
REM buffer of tlen% bytes, or 0 for no title. btype% is the work area
REM button type and nic% the number of icons that follow.
DEF PROCwin(x0%,y0%,x1%,y1%,flags%,bg%,ex0%,ey0%,ex1%,ey1%,tptr%,tlen%,btype%,nic%)
blk%!0=x0% : blk%!4=y0% : blk%!8=x1% : blk%!12=y1%
blk%!16=0 : blk%!20=0 : blk%!24=-1 : blk%!28=flags%
blk%?32=7 : blk%?33=2 : blk%?34=7 : blk%?35=bg%
blk%?36=3 : blk%?37=1 : blk%?38=12 : blk%?39=0
blk%!40=ex0% : blk%!44=ey0% : blk%!48=ex1% : blk%!52=ey1%
IF tptr%=0 THEN blk%!56=0 ELSE blk%!56=&13D
blk%!60=btype%<<12 : blk%!64=1 : blk%!68=0
blk%!72=tptr% : blk%!76=-1 : blk%!80=tlen% : blk%!84=nic%
ENDPROC

REM Write indirected icon n% into the window definition in blk%.
