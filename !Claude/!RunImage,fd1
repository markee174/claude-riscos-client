PROCline(f%,"Credit:"+credit$)
PROCline(f%,"CreditDate:"+creditdate$)
PROCline(f%,"PriceIn:"+pin$)
PROCline(f%,"PriceOut:"+pout$)
PROCline(f%,"UsedIn:"+STR$totin%)
PROCline(f%,"UsedOut:"+STR$totout%)
