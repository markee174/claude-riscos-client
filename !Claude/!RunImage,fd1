REM Read key$, model$ and cert$ from Choices:Claude.Choices.
DEF PROCloadchoices
LOCAL f%,l$
key$="" : model$="claude-sonnet-5-5" : cert$="" : checkupd%=TRUE : skiptag$=""
showusage%=TRUE : credit$="" : creditdate$="" : pin$="" : pout$="" : totin%=0 : totout%=0
f%=OPENIN "Choices:Claude.Choices"
IF f%=0 THEN ENDPROC
WHILE NOT EOF#f%
  l$=GET$#f%
  IF LEFT$(l$,4)="Key:" THEN key$=MID$(l$,5)
  IF LEFT$(l$,6)="Model:" THEN model$=MID$(l$,7)
  IF LEFT$(l$,7)="CAFile:" THEN cert$=MID$(l$,8)
  IF LEFT$(l$,13)="CheckUpdates:" THEN checkupd%=(MID$(l$,14)<>"0")
  IF LEFT$(l$,12)="SkipVersion:" THEN skiptag$=MID$(l$,13)
  IF LEFT$(l$,10)="ShowUsage:" THEN showusage%=(MID$(l$,11)<>"0")
  IF LEFT$(l$,7)="Credit:" THEN credit$=MID$(l$,8)
  IF LEFT$(l$,11)="CreditDate:" THEN creditdate$=MID$(l$,12)
  IF LEFT$(l$,8)="PriceIn:" THEN pin$=MID$(l$,9)
  IF LEFT$(l$,9)="PriceOut:" THEN pout$=MID$(l$,10)
  IF LEFT$(l$,7)="UsedIn:" THEN totin%=VAL(MID$(l$,8))
  IF LEFT$(l$,8)="UsedOut:" THEN totout%=VAL(MID$(l$,9))
ENDWHILE
CLOSE#f%
ENDPROC

REM Write the choices to <Choices$Write>.Claude.Choices.
