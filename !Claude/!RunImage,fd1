$keybuf%=key$ : $modelbuf%=model$ : $certbuf%=cert$
PROCredrawicon(choicesw%,1) : PROCredrawicon(choicesw%,3) : PROCredrawicon(choicesw%,5)
PROCsetselected(choicesw%,10,checkupd%)
