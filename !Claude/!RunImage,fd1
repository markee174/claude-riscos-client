REM Claim and fill a menu header for n% items; return its address.
DEF FNnewmenu(t$,n%)
DIM menup% 28+24*n%
$menup%=t$
menup%?12=7 : menup%?13=2 : menup%?14=7 : menup%?15=0
menup%!16=LEN t$*16+16 : menup%!20=44 : menup%!24=0
=menup%

REM Fill item i% of menu m% with indirected text t$, submenu sub%
REM and item flags f% (&80 marks the last item).
DEF PROCitem(m%,i%,t$,sub%,f%)
LOCAL a%
a%=m%+28+24*i%
a%!0=f% : a%!4=sub% : a%!8=&07000121
a%!12=FNstr(t$) : a%!16=-1 : a%!20=LEN t$+1
IF LEN t$*16+16>m%!16 THEN m%!16=LEN t$*16+16
ENDPROC

